# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://snaptask_user:snaptask_password@localhost:5432/snaptask_dev"
JWT_SECRET="change_this_to_a_long_random_string"
REDIS_URL="redis://localhost:6379"
PORT=3000

# Where the frontend runs (used in emails + CORS)
APP_URL="http://localhost:5173"

# Optional: real email delivery. Without it, emails are logged to the server console
# and verification / reset links are returned in the API response so dev still works.
# Get a free key at https://resend.com
RESEND_API_KEY=""
MAIL_FROM="SnapTask <onboarding@resend.dev>"

# Optional rate-limit overrides (defaults shown). Counters live in Redis.
# RL_SIGNUP=30    # signups per IP per hour
# RL_LOGIN=8      # failed logins per IP+email per 15 min
# RL_FORGOT=10    # password-reset requests per IP per 15 min

# Optional: error reporting. With no DSN, Sentry never initialises and makes no
# network calls — nothing is billed. Free tier at https://sentry.io
SENTRY_DSN=""
# SENTRY_TRACES_RATE=0.1   # fraction of requests traced (default 0.1)

# Logging. Pretty single lines in dev; set LOG_FORMAT=json for one JSON object
# per line, which is what log aggregators can actually query.
# LOG_LEVEL=info           # debug | info | warn | error
# LOG_FORMAT=json          # forced on when NODE_ENV=production
