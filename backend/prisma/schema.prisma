// SnapTask database schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  /// always stored lower-cased and trimmed, so Foo@Bar.com and foo@bar.com
  /// are the same account (see lib/validate.js)
  email         String    @unique
  password      String
  name          String
  avatar        String?
  emailVerified Boolean   @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedWorkspaces Workspace[]         @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  createdTasks    Task[]              @relation("TaskCreatedBy")
  assignedTasks   Task[]              @relation("TaskAssignedTo")
  comments        Comment[]
  messages        Message[]
  notifications   Notification[]
  prefs           NotificationPrefs?
  tokens          VerificationToken[]
  reactions       Reaction[]
  polls           Poll[]              @relation("PollCreatedBy")
  pollVotes       PollVote[]
  channelReads    ChannelRead[]
  taskEvents      TaskEvent[]
}

/// Single-use tokens for "verify your email" and "reset your password".
/// Only a SHA-256 hash of the token is stored, never the token itself —
/// so a database leak can't be used to take over accounts.
model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  type      String // verify_email | reset_password
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members  WorkspaceMember[]
  tasks    Task[]
  channels Channel[]
  labels   Label[]
  statuses WorkspaceStatus[]
  sprints  Sprint[]
}

/// Explicit join table so every membership carries a ROLE.
/// owner  = created the workspace, can do anything incl. delete
/// admin  = can see Team Analytics, invite/remove members, change roles below them
/// member = normal access to tasks + chat
model WorkspaceMember {
  id       String   @id @default(cuid())
  role     String   @default("member") // owner | admin | member
  joinedAt DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  /// matches a WorkspaceStatus.key for this workspace
  status      String    @default("todo")
  priority    String    @default("medium") // low | medium | high
  /// rough effort in hours. Without this every task looks the same size,
  /// which makes any forecast meaningless.
  estimateHours Float?
  dueDate     DateTime?
  startedAt   DateTime? // first time it entered an in-progress status
  completedAt DateTime? // set when it enters a status flagged isDone
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignedTo", fields: [assignedToId], references: [id])

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  labels        Label[]     @relation("TaskLabels")
  subtasks      Subtask[]
  events        TaskEvent[]
  comments      Comment[]
  messages      Message[]
  notifications Notification[]

  /// Postgres full-text index. This is a GENERATED ALWAYS ... STORED column
  /// (see the fulltext_search migration) so it can never drift from the row -
  /// Postgres recomputes it on every write. Prisma has no tsvector type, hence
  /// Unsupported: it is written by the database and read via $queryRaw only.
  /// Title is weighted 'A' and description 'B', so a title hit ranks higher.
  searchVector Unsupported("tsvector")?

  @@index([workspaceId])
  @@index([assignedToId])
  @@index([sprintId])
  @@index([completedAt])
}

/// Append-only history. This is what turns "current state" into insight:
/// cycle time, time-in-status, how often a deadline moved, who changed what.
model TaskEvent {
  id        String   @id @default(cuid())
  /// created | status | assignee | due | priority | estimate | title | label | subtask
  type      String
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// who did it (null when the system did, e.g. a reminder sweep)
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([createdAt])
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Label {
  id    String @id @default(cuid())
  name  String
  color String @default("violet")

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  tasks Task[] @relation("TaskLabels")

  @@unique([workspaceId, name])
}

/// Board columns are per-workspace, not hardcoded. `isDone` is what analytics
/// uses to decide a task is finished, so teams can rename or add columns freely.
model WorkspaceStatus {
  id       String  @id @default(cuid())
  key      String
  label    String
  color    String  @default("#7c3aed")
  position Int     @default(0)
  isDone   Boolean @default(false)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

/// A time-boxed period to report against, so burndown can be "this sprint"
/// rather than a rolling fortnight.
model Sprint {
  id        String   @id @default(cuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([workspaceId, startsAt])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// see Task.searchVector
  searchVector Unsupported("tsvector")?

  @@index([taskId])
}

/// A chat channel inside a workspace (#general, #engineering, ...)
model Channel {
  id        String   @id @default(cuid())
  name      String
  purpose   String?
  createdAt DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  messages Message[]
  reads    ChannelRead[]

  @@unique([workspaceId, name])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// optional task card attached to the message
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  reactions Reaction[]
  poll      Poll?

  /// see Task.searchVector
  searchVector Unsupported("tsvector")?

  @@index([channelId, createdAt])
}

/// One emoji from one person on one message. The unique constraint is what
/// makes reacting idempotent — clicking the same emoji twice removes it.
model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

/// A poll rides on a message, so it appears inline in the channel history.
model Poll {
  id          String    @id @default(cuid())
  question    String
  multiple    Boolean   @default(false) // allow picking more than one option
  closesAt    DateTime?
  createdAt   DateTime  @default(now())

  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("PollCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  options PollOption[]
}

model PollOption {
  id       String @id @default(cuid())
  text     String
  position Int    @default(0)

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  votes PollVote[]
}

model PollVote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([userId])
}

/// How far through a channel each person has read — powers unread badges
/// and the "seen by" row under the newest message.
model ChannelRead {
  id       String   @id @default(cuid())
  lastReadAt DateTime @default(now())

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String // assigned | mention | comment | status | due | overdue
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String // the recipient
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  workspaceId String?
  channelId   String?

  @@index([userId, read])
}

model NotificationPrefs {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailAssigned Boolean @default(true)
  emailMention  Boolean @default(true)
  emailComment  Boolean @default(true)
  emailStatus   Boolean @default(false)

  dailyDigest  Boolean @default(true)
  digestHour   Int     @default(8)
  weeklyReport Boolean @default(true)

  remindBeforeDue Boolean @default(true)
  remindHours     Int     @default(24)
  nudgeOverdue    Boolean @default(true)
}
