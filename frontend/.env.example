# Copy to .env for local overrides. In dev the Vite proxy sends /api to
# http://localhost:3000, so none of this is needed to run the app.

# Production only: where the deployed API lives.
VITE_API_URL=""

# Optional: browser error reporting. Left empty, @sentry/react is not even
# included in the bundle — the dynamic import is dead code and gets stripped.
VITE_SENTRY_DSN=""
